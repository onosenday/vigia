  {
   "id": 18,
   "title": "Activo / inactivo",
   "type": "state-timeline",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 22
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (mostrar, zmac) (label_replace((time() - netinv_device_last_seen_seconds < bool 1800) * on (mac) group_left (mostrar) max by (mac, mostrar) (netinv_device_info), \"zmac\", \"$1\", \"mac\", \"(.*)\"))",
     "legendFormat": "{{mostrar}}",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "inactivo",
         "color": "rgba(128, 128, 128, 0.25)"
        },
        "1": {
         "text": "activo",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "rgba(128, 128, 128, 0.25)",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "rowHeight": 0.85,
    "legend": {
     "showLegend": false
    }
   }
  },
