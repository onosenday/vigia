{
 "uid": "ejm-contenedores",
 "title": "Ejemplo · Contenedores",
 "tags": [
  "Ejemplo"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "1m",
 "editable": false,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Ahora",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 2,
   "title": "Contenedores en marcha",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count by (nombre) (container_last_seen{job=\"cadvisor\",nombre=\"Nodo 1\",name!=\"\"})",
     "legendFormat": "Nodo 1",
     "instant": true,
     "range": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count by (nombre) (container_last_seen{job=\"cadvisor\",nombre=\"nodo2\",name!=\"\"})",
     "legendFormat": "nodo2",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "textMode": "value_and_name",
    "colorMode": "none"
   }
  },
  {
   "id": 3,
   "title": "Más RAM",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 1,
    "w": 9,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(12, container_memory_working_set_bytes{job=\"cadvisor\",name!=\"\"})",
     "legendFormat": "{{name}} ({{nombre}})",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1000000000.0
       },
       {
        "color": "red",
        "value": 3000000000.0
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient"
   }
  },
  {
   "id": 4,
   "title": "Más CPU (núcleos)",
   "type": "bargauge",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 15,
    "y": 1,
    "w": 9,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(12, rate(container_cpu_usage_seconds_total{job=\"cadvisor\",name!=\"\"}[5m]))",
     "legendFormat": "{{name}} ({{nombre}})",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "red",
        "value": 1.5
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient"
   }
  },
  {
   "id": 5,
   "title": "Arrancados hace menos de 1 h",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(time() - container_start_time_seconds{job=\"cadvisor\",name!=\"\"}) < 3600",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {},
   "transformations": [
    {
     "id": "organize",
     "options": {
      "includeByName": {
       "name": true,
       "nombre": true,
       "Value": true
      },
      "renameByName": {
       "name": "Contenedor",
       "nombre": "Host",
       "Value": "Hace"
      }
     }
    }
   ]
  },
  {
   "id": 10,
   "type": "row",
   "title": "Histórico",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
