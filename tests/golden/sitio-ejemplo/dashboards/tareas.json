            "color": "text"
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    },
    "sortBy": [
     {
      "displayName": "Host",
      "desc": false
     }
    ]
   },
   "transformations": [
    {
     "id": "merge",
     "options": {}
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "nombre": "Host",
       "Value #A": "Último éxito (h)",
       "Value #B": "Margen (h)",
       "Value #C": "Resultado",
       "tarea": "Tarea"
      }
     }
    }
   ]
  }
 ],
