  {
   "id": 2,
   "title": "Estado",
   "type": "table",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 24,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (nombre, tipo, puerto) (probe_success{job=\"externo\"})",
     "legendFormat": "{{nombre}}",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (nombre, tipo, puerto) (probe_duration_seconds{job=\"externo\"})",
     "legendFormat": "{{nombre}}",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (nombre, tipo, puerto) (probe_http_status_code{job=\"externo\"})",
     "legendFormat": "{{nombre}}",
     "instant": true,
     "range": false,
     "format": "table"
    },
    {
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min by (nombre, tipo, puerto) ((probe_ssl_earliest_cert_expiry{job=\"externo\"} - time()) / 86400)",
     "legendFormat": "{{nombre}}",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
