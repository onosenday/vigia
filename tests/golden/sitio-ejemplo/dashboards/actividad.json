{
 "uid": "ejm-actividad",
 "title": "Ejemplo · Actividad de dispositivos",
 "tags": [
  "Ejemplo"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5m",
 "editable": false,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 2,
   "title": "Activos ahora",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count((time() - netinv_device_last_seen_seconds < bool 1800) == 1) or vector(0)",
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "value",
    "text": {
     "titleSize": 12,
     "valueSize": 26
    }
   }
  },
  {
   "id": 3,
   "title": "Inactivos ahora",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count((time() - netinv_device_last_seen_seconds < bool 1800) == 0) or vector(0)",
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "value",
    "text": {
     "titleSize": 12,
     "valueSize": 26
    }
   }
  },
  {
   "id": 4,
   "title": "Vistos en 30 días",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 3
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(netinv_device_info) or vector(0)",
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "text",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "graphMode": "none",
    "colorMode": "value",
    "text": {
     "titleSize": 12,
     "valueSize": 26
    }
   }
  },
  {
   "id": 5,
   "title": "Activo / inactivo",
   "type": "state-timeline",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 24,
    "h": 32
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (mostrar, zmac) (label_replace(max_over_time((time() - netinv_device_last_seen_seconds < bool 1800)[$__interval:5m]) * on (mac) group_left (mostrar) max by (mac, mostrar) (netinv_device_info), \"zmac\", \"$1\", \"mac\", \"(.*)\"))",
     "legendFormat": "{{mostrar}}",
     "instant": false,
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "inactivo",
         "color": "rgba(128, 128, 128, 0.25)"
        },
        "1": {
         "text": "activo",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "rgba(128, 128, 128, 0.25)",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "showValue": "never",
    "mergeValues": true,
    "rowHeight": 0.85,
    "legend": {
     "showLegend": false
    }
   },
   "interval": "900s"
  }
 ],
 "links": [
  {
   "title": "Inicio · Ejemplo",
   "type": "link",
   "icon": "dashboard",
   "url": "/d/ejm-inicio",
   "targetBlank": false
  }
 ]
}