{% macro watchtower_labels(s) %}
{% if s.monitor.watchtower %}
    labels:
      - "com.centurylinklabs.watchtower.enable=true"
{% endif %}
{% endmacro %}
{% macro node_exporter(s, h, prefix) %}
  # Métricas del host (CPU, RAM, discos, red, temperatura) en :{{ h.node_exporter.puerto | raw }}
  node-exporter:
    image: {{ s.monitor.image("node_exporter") }}
    container_name: {{ prefix ~ "node-exporter" }}
    restart: unless-stopped
    command:
      - '--path.rootfs=/host'
{% if h.node_exporter.puerto != 9100 %}
      - {{ "--web.listen-address=:" ~ h.node_exporter.puerto }}
{% endif %}
      - '--collector.filesystem.mount-points-exclude=^/(dev|proc|run|sys|var/lib/docker/.+|srv/.+/docker/.+)($$|/)'
{% if h.node_exporter.textfile %}
      - {{ ("'--collector.textfile.directory=/host" ~ TEXTFILE_DIR ~ "'") | raw }}
{% endif %}
    network_mode: host
    pid: host
    volumes:
      - /:/host:ro,rslave
{{ watchtower_labels(s) | raw }}
{%- endmacro %}
{% macro cadvisor(s, h, prefix) %}
  # Métricas por contenedor (CPU, RAM, red) en :{{ h.cadvisor.puerto | raw }}
  cadvisor:
    image: {{ s.monitor.image("cadvisor") }}
    container_name: {{ prefix ~ "cadvisor" }}
    restart: unless-stopped
    command:
      - '--docker_only=true'
      - '--housekeeping_interval=30s'
      - '--store_container_labels=false'
      - '--whitelisted_container_labels=com.docker.compose.project'
      - '--disable_metrics=percpu,sched,tcp,udp,disk,diskIO,hugetlb,referenced_memory,cpu_topology,resctrl,advtcp,process'
    privileged: true
    devices:
      - /dev/kmsg
    ports:
      - {{ h.cadvisor.puerto ~ ":8080" }}
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - {{ h.docker_root ~ ":/var/lib/docker:ro" }}
      - /dev/disk/:/dev/disk:ro
{{ watchtower_labels(s) | raw }}
{%- endmacro %}
{% macro wud(s, h, prefix) %}
  # What's Up Docker: ¿hay imagen nueva de cada contenedor? Métricas en :{{ h.imagenes.puerto | raw }}/metrics
  # (docs/imagenes.md). Solo lee el socket de Docker: sin triggers, no actualiza nada.
  wud:
    image: {{ s.monitor.image("wud") }}
    container_name: {{ prefix ~ "wud" }}
    restart: unless-stopped
    environment:
      - {{ "WUD_WATCHER_LOCAL_CRON=" ~ s.modulos.imagenes.cron }}
      - WUD_WATCHER_LOCAL_WATCHDIGESTDEFAULT=true
      - WUD_PROMETHEUS_AUTH=false
      - WUD_AUTH_ADMIN_USER=vigia
      - {{ "WUD_AUTH_ADMIN_PASSWORD=${" ~ s.modulos.imagenes.clave ~ "}" }}
    ports:
      - {{ h.imagenes.puerto ~ ":3000" }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
{{ watchtower_labels(s) | raw }}
{%- endmacro %}
